@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

find_dependency(metaSMT REQUIRED)
if("@WITH_SYSTEMC@")
    find_dependency(SystemCLanguage)
endif()
find_package(Boost CONFIG REQUIRED COMPONENTS filesystem)

include("${CMAKE_CURRENT_LIST_DIR}/crave-targets.cmake")

set(crave_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set(crave_LIBRARIES crave::crave)