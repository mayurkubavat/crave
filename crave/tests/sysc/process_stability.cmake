# Runs PROGRAM in the modes 0, 1 and 2 and checks that it prints the same sequence of values.
foreach(mode 0 1 2)
  execute_process(COMMAND ${PROGRAM} ${mode} OUTPUT_VARIABLE output RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "mode ${mode} failed: ${result}")
  endif()
  string(REGEX MATCH "sequence:[^\n]*" sequence_${mode} "${output}")
  if(NOT sequence_${mode})
    message(FATAL_ERROR "mode ${mode} did not print a sequence")
  endif()
  message(STATUS "mode ${mode} ${sequence_${mode}}")
endforeach()
if(NOT sequence_0 STREQUAL sequence_1 OR NOT sequence_0 STREQUAL sequence_2)
  message(FATAL_ERROR "the sequence depends on the other process")
endif()
